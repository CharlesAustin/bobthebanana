---
import type { PostInstance } from "../env";
import LocaleDate from "./LocaleDate.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const posts = Object.values(
  import.meta.glob("../pages/posts/*.mdx", { eager: true }),
) as PostInstance[];
const latestPost = posts.sort((a, b) => {
  return (
    new Date(b.frontmatter.date).valueOf() -
    new Date(a.frontmatter.date).valueOf()
  );
})[0];
---

{
  latestPost ? (
    <section class={className}>
      <h2 class="text-sprout-green font-dm-sans border-sprout-green/30 border-b pb-2 text-lg font-bold uppercase">
        Latest Post
      </h2>
      <article class="mt-8">
        <a
          class="border-leaf-green block rounded-lg border bg-white p-4"
          href={latestPost.url}
          aria-label="Go to latest post"
        >
          <h3 class="text-sprout-green">{latestPost.frontmatter.title}</h3>
          <LocaleDate date={latestPost.frontmatter.date} />
        </a>
      </article>
    </section>
  ) : (
    <p class={className}>No posts found...yet.</p>
  )
}
