---
import { type CollectionEntry, getCollection } from "astro:content";
import LocaleDate from "./LocaleDate.astro";
import { Picture } from "astro:assets";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const allPosts = await getCollection("posts");
const latestPost = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)[0];

const {
  title,
  author,
  description,
  pubDate,
  updatedDate,
  featImage,
  featImageAlt,
} = latestPost.data;
---

{
  latestPost ? (
    <section class={className}>
      <h2 class="text-sprout-green font-dm-sans border-sprout-green/30 border-b pb-2 text-lg font-bold uppercase">
        Latest Post
      </h2>
      <article class="mt-8">
        <a
          class="group border-leaf-green hover:shadow-sprout-green/30 relative block overflow-hidden rounded-xl border bg-white p-4 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md sm:p-6"
          href={`/posts/${latestPost.id}/`}
          aria-label="Go to latest post"
        >
          <div class="flex">
            {featImage && (
              <div class="mt-1.5 shrink-0">
                <Picture
                  src={featImage}
                  alt={featImageAlt}
                  width={240}
                  height={240}
                  class="mb-0 size-30 rounded-lg object-cover"
                />
              </div>
            )}
            <div class="self-center pr-3 pl-4 sm:pl-6">
              <h3 class="text-sprout-green mb-1">{title}</h3>
              <LocaleDate date={pubDate} class="text-base" />
              {description && <p class="mb-0 hidden sm:block">{description}</p>}
              <span class="text-sprout-green mt-2 hidden items-center justify-end gap-0.5 text-base font-medium sm:flex">
                <span>Continue reading</span>
                <span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    height="24px"
                    viewBox="0 -960 960 960"
                    width="24px"
                    fill="currentColor"
                    class="text-sprout-green group-hover:text-banana-yellow hidden shrink-0 self-center transition-colors duration-300 sm:block"
                  >
                    <path d="M530-481 332-679l43-43 241 241-241 241-43-43 198-198Z" />
                  </svg>
                </span>
              </span>
            </div>
          </div>
          {description && <p class="mt-4 mb-0 sm:hidden">{description}</p>}
        </a>
      </article>
    </section>
  ) : (
    <p class={className}>No posts found...yet.</p>
  )
}
