---
const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  const normalize = (path: string) => path.replace(/\/$/, "") || "/";
  return normalize(pathname) === normalize(href);
};

const navItems = [
  { name: "Posts", href: "/posts" },
  { name: "About", href: "/about" },
];
---

<nav class="flex items-center justify-between">
  <menu class="flex gap-3">
    {
      navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class={
              isActive(item.href)
                ? "bg-sprout-green text-canvas block rounded-xl border-2 text-base sm:text-lg" +
                  " px-2.5 py-1.5 sm:px-3 sm:py-2" +
                  " border-sprout-green"
                : "hover:border-banana-yellow block rounded-xl border-2 text-base transition-colors sm:text-lg" +
                  " duration-200 ease-linear" +
                  " border-transparent px-2.5 py-1.5 sm:px-3 sm:py-2"
            }
          >
            {item.name}
          </a>
        </li>
      ))
    }
  </menu>
</nav>
