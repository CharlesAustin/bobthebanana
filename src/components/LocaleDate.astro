---
interface Props {
  date: string | Date;
  class?: string;
}

const { date, class: className } = Astro.props;
const dateObj = date instanceof Date ? date : new Date(date);

const formattedDate = dateObj.toLocaleDateString("en-CA", {
  timeZone: "UTC",
});
---

<time class={className + " block"} datetime={dateObj.toISOString()}>
  {formattedDate}
</time>
