---
import Layout from "../../layouts/Layout.astro";
import Main from "../../layouts/Main.astro";
import LocaleDate from "../../components/LocaleDate.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");
---

<Layout>
  <Main>
    <h1 class="font-fraunces text-5xl">All Posts</h1>
    <ul>
      {
        allPosts.map((post: any) => (
          <li>
            <a
              class="group border-b-leaf-green flex items-center justify-between border-b py-4"
              href={`/posts/${post.id}/`}
            >
              <div class="">
                <h2 class="font-fraunces mb-1 text-3xl">{post.data.title}</h2>
                <LocaleDate date={post.data.pubDate} />
              </div>
              <div class="flex items-center gap-2">
                <span class="opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                  Read this post
                </span>
                <span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    height="48px"
                    viewBox="0 -960 960 960"
                    width="48px"
                    fill="currentColor"
                    class="text-sprout-green group-hover:text-banana-yellow transition-colors duration-300"
                  >
                    <path d="M530-481 332-679l43-43 241 241-241 241-43-43 198-198Z" />
                  </svg>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </Main>
</Layout>
