---
import Layout from "../layouts/Layout.astro";
import Main from "../layouts/Main.astro";
import LocaleDate from "../components/LocaleDate.astro";
const getPosts = Object.values(
  import.meta.glob("./posts/*.md", { eager: true }),
);
---

<Layout>
  <Main>
    <h1 class="font-fraunces text-5xl">All Posts</h1>
    <ul>
      {
        getPosts.map((post: any) => (
          <li>
            <a
              class="group border-t-leaf-green flex items-center justify-between border-t py-4"
              href={post.url}
            >
              <div class="">
                <h2 class="font-fraunces mb-1 text-3xl">
                  {post.frontmatter.title}
                </h2>
                <LocaleDate date={post.frontmatter.date} />
              </div>
              <div class="flex items-center gap-2">
                <span class="opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                  Continue Reading
                </span>
                <span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    height="48px"
                    viewBox="0 -960 960 960"
                    width="48px"
                    fill="currentColor"
                    class="text-sprout-green group-hover:text-banana-yellow transition-colors duration-300"
                  >
                    <path d="M530-481 332-679l43-43 241 241-241 241-43-43 198-198Z" />
                  </svg>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </Main>
</Layout>
