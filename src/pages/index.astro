---
import Layout from "../layouts/Layout.astro";
import Main from "../layouts/Main.astro";
import { Content as IndexContent } from "../components/indexContent.md";
import LatestPost from "../components/LatestPost.astro";
---

<Layout>
  <Main>
    <IndexContent />
    <a
      class="bg-banana-yellow inline-block rounded-xl px-5 py-3 transition-colors duration-300 hover:bg-yellow-400"
      href="/about">WTF is this?</a
    >
    <LatestPost class="mt-10" />
  </Main>
</Layout>
