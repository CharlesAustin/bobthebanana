---
import Layout from "./Layout.astro";
import Main from "../layouts/Main.astro";
import type { MarkdownLayoutProps } from "astro";
import LocaleDate from "../components/LocaleDate.astro";
import type { CollectionEntry } from "astro:content";
import Picture from "astro/components/Picture.astro";

type Props = CollectionEntry<"posts">["data"];

const { title, description, pubDate, updatedDate, featImage, featImageAlt } =
  Astro.props;
---

<Layout>
  <Main>
    <article>
      <h1 class="font-fraunces text-5xl">{title}</h1>
      <LocaleDate
        date={pubDate}
        class="border-leaf-green mb-5 inline-block rounded-xl border px-3 py-1.5 text-base"
      />
      {
        featImage && (
          <Picture
            src={featImage}
            alt={featImageAlt}
            formats={["avif", "webp"]}
            layout="full-width"
            width={1600}
            height={900}
          />
        )
      }
      <slot />
    </article>
  </Main>
</Layout>
