---
import Layout from "./Layout.astro";
import Main from "../layouts/Main.astro";
import type { MarkdownLayoutProps } from "astro";
import LocaleDate from "../components/LocaleDate.astro";
import type { CollectionEntry } from "astro:content";

type Props = CollectionEntry<"posts">["data"];

const { title, description, pubDate, updatedDate, featImage } = Astro.props;
---

<Layout>
  <Main>
    <article>
      <h1 class="font-fraunces text-5xl">{title}</h1>
      <LocaleDate
        date={pubDate}
        class="border-leaf-green mb-5 inline-block rounded-xl border px-3 py-1.5 text-base"
      />
      <slot />
    </article>
  </Main>
</Layout>
