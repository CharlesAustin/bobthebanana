---
import Layout from "./Layout.astro";
import Main from "../layouts/Main.astro";
import type { MarkdownLayoutProps } from "astro";
import type { PostFrontmatter } from "../env";
import LocaleDate from "../components/LocaleDate.astro";

type Props = MarkdownLayoutProps<PostFrontmatter>;
const { frontmatter } = Astro.props;
---

<Layout>
  <Main>
    <article>
      <h1 class="font-fraunces text-5xl">{frontmatter.title}</h1>
      <LocaleDate date={frontmatter.date} />
      <slot />
    </article>
  </Main>
</Layout>
